   "title": "Use modular monolith as system architecture style",
   "first_commit": "2020-03-02T22:41:24+01:00",
   "first_sha": "821efad2b1447cc710a3ddc37bc8a3d7177252e2",
   "last_commit": "2025-10-26T10:53:06+01:00",
   "author": "Mateusz Midor",
